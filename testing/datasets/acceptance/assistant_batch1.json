      "case_id": "CL-01",
      "title": "一句话完整创建线索",
      "login": "sales01",
      "password": "123456",
      "repeat": 1,
      "turns": [
        {
          "message": "帮我创建一个线索，公司名称第一批验收科技-{{suffix}}，联系人张三，手机号1381100{{phone_tail}}，备注第一批验收",
          "context": {},
          "expect": {
            "result_kind": "lead_created"
          }
        }
      ]
    },
    {
      "case_id": "CL-05",
      "title": "先给公司名",
      "login": "sales01",
      "password": "123456",
      "repeat": 1,
